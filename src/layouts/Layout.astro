---
import '../styles/global.css';

const { judul = "Portofolio - Hafiz Kurniawan" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{judul}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Futuristic ambient light blobs -->
    <div class="ambient-glow glow-1" aria-hidden="true"></div>
    <div class="ambient-glow glow-2" aria-hidden="true"></div>

    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand-logo" aria-label="Beranda Hafiz Kurniawan">
          <span class="logo-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L3 7V17L12 22L21 17V7L12 2Z" stroke="#ffffff" stroke-width="2" stroke-linejoin="round"/>
              <path d="M12 22V12" stroke="#ffffff" stroke-width="2"/>
              <path d="M21 7L12 12L3 7" stroke="#ffffff" stroke-width="2"/>
              <circle cx="12" cy="12" r="2.5" fill="#38bdf8"/>
            </svg>
          </span>
          <span class="logo-text">
            <strong>Hafiz Kurniawan</strong>
            <small>ICT Educator</small>
          </span>
        </a>

        <nav class="nav-links">
          <a href="/" class={currentPath === '/' ? 'active' : ''}>
            <span class="nav-dot"></span>
            Beranda
          </a>
          <a href="/prestasi" class={currentPath.startsWith('/prestasi') ? 'active' : ''}>
            <span class="nav-dot"></span>
            Prestasi
          </a>
          <a href="/proyek" class={currentPath.startsWith('/proyek') ? 'active' : ''}>
            <span class="nav-dot"></span>
            Proyek
          </a>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-divider"></div>
      <div class="footer-content">
        <div class="footer-brand">
          <span class="footer-logo">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L3 7V17L12 22L21 17V7L12 2Z" stroke="url(#footer-grad)" stroke-width="2" stroke-linejoin="round"/>
              <path d="M12 22V12" stroke="url(#footer-grad)" stroke-width="2"/>
              <path d="M21 7L12 12L3 7" stroke="url(#footer-grad)" stroke-width="2"/>
              <circle cx="12" cy="12" r="2.5" fill="#06b6d4"/>
              <defs>
                <linearGradient id="footer-grad" x1="3" y1="2" x2="21" y2="22" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#2563eb"/>
                  <stop offset="1" stop-color="#06b6d4"/>
                </linearGradient>
              </defs>
            </svg>
          </span>
          <p class="footer-tagline">Belajar Bareng • Berbagi • Diskusi • Berolahraga</p>
        </div>

        <div class="footer-badges">
          <span class="tech-badge">HTML</span>
          <span class="tech-badge">CSS</span>
          <span class="tech-badge">Astro JS</span>
        </div>

        <div class="footer-bottom">
          <p>&copy; 2026 <strong>Hafiz Kurniawan</strong>. All rights reserved.</p>
          <a href="#top" class="back-to-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;">
            Ke Atas ↑
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
