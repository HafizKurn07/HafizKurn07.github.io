---
import Layout from '../layouts/Layout.astro';

const nama = "Hafiz Kurniawan";
const kelas = "Guru ICT";
const sekolah = "SMPII Al Abidin Boyolali";
const foto = "/foto/profil.jpg";
const biografi = "Saya adalah seorang pendidik bidang ICT di SMPII Al Abidin Boyolali yang berdedikasi menciptakan ruang belajar interaktif, berbagi wawasan teknologi, dan bertumbuh bersama peserta didik. Bagi saya, keseimbangan hidup adalah kunci—selalu antusias mengeksplorasi inovasi digital sekaligus aktif menjaga semangat dan kebugaran melalui olahraga serta petualangan alam terbuka.";
---

<Layout judul="Beranda - Hafiz Kurniawan">
  <div class="hero-intro">
    <span class="status-badge">
      <span class="pulsing-dot"></span>
      ICT Educator • Sport Enthusiast
    </span>
    <h1>Halo, aku {nama} 👋</h1>
  </div>

  <div class="biodata">
    <img class="foto-profil" src={foto} alt="Foto profil Hafiz Kurniawan" />

    <div class="info-diri">
      <p><strong>Nama:</strong> {nama}</p>
      <p><strong>Pekerjaan:</strong> <span class="role-highlight">{kelas}</span></p>
      <p><strong>Sekolah:</strong> {sekolah}</p>


    </div>
  </div>

  <section class="section-card">
    <h2>Tentang Aku</h2>
    <p class="bio-text">{biografi}</p>
  </section>

  <section class="section-card">
    <h2>Hobi & Kegemaran</h2>
    <div class="hobi-chips">
      <span class="chip">
        <span class="chip-icon">🏃‍♂️</span>
        <span class="chip-text">Trail Running</span>
      </span>
      <span class="chip">
        <span class="chip-icon">🥾</span>
        <span class="chip-text">Hiking</span>
      </span>
      <span class="chip">
        <span class="chip-icon">🏐</span>
        <span class="chip-text">Volleyball</span>
      </span>
      <span class="chip">
        <span class="chip-icon">⚽</span>
        <span class="chip-text">Football</span>
      </span>
    </div>
  </section>
</Layout>
